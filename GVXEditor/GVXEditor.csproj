<Project Sdk="Microsoft.NET.Sdk">
	<!-- Editor dat servera INISS2 (IniSrv): grafikon GV.XML a subory stanic. Zapisuje len pri zastavenom serveri. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>GVXEditor</RootNamespace>
		<AssemblyName>GVXEditor</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- verzia lokalnych zostav; vydanie ju prepise verziou zo znacky vX.Y (ToolsCore\Build\AppRelease.props) -->
		<Version>1.0.0</Version>
		<Copyright>Copyright © 2026</Copyright>
		<Description>Editor dát servera INISS2</Description>
		<NeutralLanguage>sk</NeutralLanguage>
		<ApplicationIcon>gvx.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>default</LangVersion>
		<!-- Orezanie vystupu pre instalator ako v ostatnych programoch: bez RID kopiruje SDK do runtimes\ aj kniznice pre
		     ine systemy, AppendRuntimeIdentifierToOutputPath=false drzi vystup v priecinku, z ktoreho bera instalator. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- slovencina je v hlavnej zostave, prelozena je len cestina -->
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="gvx.ico" />
		<!-- licencie su v koreni repozitara; Link urcuje, kam sa skopiruju vo vystupe -->
		<Content Include="..\Licences\GPLv3.txt" Link="Licences\GPLv3.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\Licences\LICENCE.txt" Link="Licences\LICENCE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore.CodeEditor\ToolsCore.CodeEditor.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore.Iniss2\ToolsCore.Iniss2.csproj" />
	</ItemGroup>
	<!-- spolocne vlastnosti vydavanych programov: vyrobca, verzia a index aktualizacii z vydania -->
	<Import Project="..\..\ToolsCore\Build\AppRelease.props" />
	<!-- IniSrvBridge je samostatny x86 proces .NET Framework (nacita IniSrv.exe instalacie), preto sa nelinkuje ako
	     referencia, ale iba zostavi a skopiruje vedla GVXEditor.exe. -->
	<Target Name="BuildIniSrvBridge" BeforeTargets="Build">
		<!-- restore s inou globalnou vlastnostou, aby Build nacital projekt az po nom (ako ELISBridge v GVDEditore) -->
		<MSBuild Projects="..\IniSrvBridge\IniSrvBridge.csproj" Targets="Restore"
		         Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
		<MSBuild Projects="..\IniSrvBridge\IniSrvBridge.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
	</Target>
	<Target Name="CopyIniSrvBridge" AfterTargets="Build">
		<ItemGroup>
			<IniSrvBridgeOutput Include="..\IniSrvBridge\bin\$(Configuration)\net48\IniSrvBridge.exe;..\IniSrvBridge\bin\$(Configuration)\net48\IniSrvBridge.exe.config" />
		</ItemGroup>
		<Copy SourceFiles="@(IniSrvBridgeOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>
